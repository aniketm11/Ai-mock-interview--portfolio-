NODE_ENV=production
PORT=3000
# Optional for same-origin Vercel deployment. Leave unset when the browser and API share one origin.
APP_ORIGIN=https://your-project.vercel.app
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MARIADB_HOST=your-mysql-host
MARIADB_PORT=3306
MARIADB_DATABASE=ai_interview
MARIADB_USER=ai_interview_app
MARIADB_PASSWORD=replace_me
# Optional: path to a local CA PEM file, or paste certificate contents when supported.
MARIADB_SSL_CA=
